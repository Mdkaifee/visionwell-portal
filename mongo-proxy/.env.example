# Copy to .env for local runs. Never commit the real file.
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/MishaEyeCare?appName=Cluster0
PROXY_SECRET=replace-with-a-long-random-string
PORT=8787

# Sends appointment-status emails via the Gmail REST API (OAuth2, HTTPS —
# not SMTP, which Render blocks outbound). See README.md for setup; the
# refresh token needs renewing roughly every 7 days while the OAuth consent
# screen is in Google's "Testing" mode.
GMAIL_USER=youraccount@gmail.com
GOOGLE_CLIENT_ID=replace-with-your-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-a-refresh-token-from-oauth-playground

# Only used by `npm run seed`, not read by the server itself.
SEED_DOCTOR_EMAIL=mdkaifee8298@gmail.com
SEED_DOCTOR_PASSWORD=replace-with-a-strong-password
SEED_DOCTOR_NAME=Dr. Misha
