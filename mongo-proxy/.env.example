# Copy to .env for local runs. Never commit the real file.
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/MishaEyeCare?appName=Cluster0
PROXY_SECRET=replace-with-a-long-random-string
PORT=8787

# Only used by `npm run seed`, not read by the server itself.
SEED_DOCTOR_EMAIL=doctor@mishaeyecare.in
SEED_DOCTOR_PASSWORD=replace-with-a-strong-password
SEED_DOCTOR_NAME=Dr. Misha
